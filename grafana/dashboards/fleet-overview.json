{
  "uid": "fleet-overview",
  "title": "Fleet overview",
  "tags": [
    "fleet"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "trailer",
        "label": "Trailer",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "fleetdb"
        },
        "query": "SELECT trailer_id FROM trailer_status ORDER BY 1",
        "definition": "SELECT trailer_id FROM trailer_status ORDER BY 1",
        "refresh": 1,
        "current": {
          "text": "TR-001",
          "value": "TR-001"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Fleet status",
      "description": "Latest status per trailer. Status comes from the retained status topic and the MQTT Last Will.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.trailer_id AS \"Trailer\", s.site_id AS \"Site\", s.state AS \"Status\",\n       r.active_modules || ' / ' || s.n_modules AS \"Modules running\",\n       round(r.total_load_kw::numeric, 1) AS \"Load kW\",\n       round(r.fuel_tank_pct::numeric, 0) AS \"Fuel %\",\n       round(extract(epoch FROM now() - r.time)::numeric, 0) AS \"Last reading (s ago)\"\nFROM trailer_status s\nLEFT JOIN LATERAL (SELECT * FROM trailer_readings t WHERE t.trailer_id = s.trailer_id\n                   ORDER BY time DESC LIMIT 1) r ON true\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "online": {
                        "color": "green",
                        "index": 0
                      },
                      "offline": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fuel %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 20
                    },
                    {
                      "color": "green",
                      "value": 35
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Load vs. modules running: $trailer",
      "description": "Modularity in action: modules start and stop to follow the load.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('$__interval', time) AS time,\n       avg(total_load_kw) AS \"Load kW\", max(active_modules) AS \"Modules running\"\nFROM trailer_readings WHERE $__timeFilter(time) AND trailer_id = '$trailer'\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Modules running"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "state-timeline",
      "title": "Module running / standby: $trailer",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, module_id AS metric, max(running) AS value\nFROM module_readings WHERE $__timeFilter(time) AND trailer_id = '$trailer'\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#555555"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#555555",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "standby",
                  "color": "#555555",
                  "index": 0
                },
                "1": {
                  "text": "running",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Engine RPM per module: $trailer",
      "description": "Variable speed: RPM follows load instead of sitting at a fixed 1800.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, module_id AS metric, avg(rpm) AS value\nFROM module_readings WHERE $__timeFilter(time) AND trailer_id = '$trailer' AND running = 1\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Exhaust temperature per module: $trailer",
      "description": "Red line = warning threshold (520 C). Spikes line up with crane hard-starts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, module_id AS metric, max(exhaust_temp_c) AS value\nFROM module_readings WHERE $__timeFilter(time) AND trailer_id = '$trailer'\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 520
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fuel tank: $trailer",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, avg(fuel_tank_pct) AS \"Fuel %\"\nFROM trailer_readings WHERE $__timeFilter(time) AND trailer_id = '$trailer'\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fleet fuel burn by trailer (1-min rollup)",
      "description": "Reads the continuous aggregate (module_1m), not raw data: this is what keeps dashboards fast at scale.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 8,
        "y": 31,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, trailer_id AS metric, sum(fuel_rate_gph) AS value\nFROM module_1m WHERE $__timeFilter(bucket)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "gal/h",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Data delay: arrival time minus measured time",
      "description": "Normally about 0-10 s (gateway bundles 10 s at a time). During a cell outage this jumps to hours, but readings still land at their MEASURED time.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 16,
        "y": 31,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('$__interval', time) AS time,\n       avg(extract(epoch FROM received_at - time)) AS \"avg delay\",\n       max(extract(epoch FROM received_at - time)) AS \"max delay\"\nFROM trailer_readings WHERE $__timeFilter(time)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "table",
      "title": "Alarms and events (whole fleet)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time AS \"Time\", trailer_id AS \"Trailer\", module_id AS \"Module\",\n       severity AS \"Severity\", code AS \"Code\", detail AS \"Detail\"\nFROM events WHERE $__timeFilter(time)\nORDER BY time DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "info": {
                        "color": "blue",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      },
                      "critical": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {}
    }
  ]
}